{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "uk.co.zarb.ecoflow",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "EcoFlow - Balcony Solar"
  },
  "description": {
    "en": "Monitor and control EcoFlow PowerStream and STREAM energy systems."
  },
  "category": [
    "energy"
  ],
  "brandColor": "#1AA3E8",
  "permissions": [],
  "images": {
    "small": "/assets/images/small.png",
    "large": "/assets/images/large.png",
    "xlarge": "/assets/images/xlarge.png"
  },
  "author": {
    "name": "Justin Zarb",
    "email": "justin.zarb@zarb.co.uk"
  },
  "flow": {
    "triggers": [
      {
        "id": "battery_level_crossed",
        "title": {
          "en": "Battery level crossed"
        },
        "titleFormatted": {
          "en": "Battery level goes [[direction]] [[level]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "dropdown",
            "name": "direction",
            "values": [
              {
                "id": "above",
                "title": {
                  "en": "above"
                }
              },
              {
                "id": "below",
                "title": {
                  "en": "below"
                }
              }
            ]
          },
          {
            "type": "number",
            "name": "level",
            "min": 0,
            "max": 100,
            "step": 1,
            "placeholder": {
              "en": "%"
            }
          }
        ],
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery"
            },
            "example": 20
          }
        ]
      },
      {
        "id": "grid_power_changed",
        "title": {
          "en": "Grid power changed"
        },
        "titleFormatted": {
          "en": "Grid power changed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Grid power"
            },
            "example": -800
          }
        ]
      },
      {
        "id": "solar_power_changed",
        "title": {
          "en": "Solar power changed"
        },
        "titleFormatted": {
          "en": "Solar power changed"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Solar power"
            },
            "example": 450
          }
        ]
      }
    ],
    "conditions": [
      {
        "id": "feed_in_enabled",
        "title": {
          "en": "Grid feed-in !{{is|is not}} enabled"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ]
      },
      {
        "id": "operating_mode_is",
        "title": {
          "en": "Operating mode !{{is|is not}}"
        },
        "titleFormatted": {
          "en": "Operating mode !{{is|is not}} [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "self_powered",
                "title": {
                  "en": "Self-powered"
                }
              },
              {
                "id": "ai",
                "title": {
                  "en": "AI / Smart scheduling"
                }
              },
              {
                "id": "scheduled",
                "title": {
                  "en": "Scheduled"
                }
              },
              {
                "id": "tou",
                "title": {
                  "en": "Time-of-use"
                }
              }
            ]
          }
        ]
      }
    ],
    "actions": [
      {
        "id": "set_ac_output",
        "title": {
          "en": "Set AC output"
        },
        "titleFormatted": {
          "en": "Turn AC output [[output]] [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "dropdown",
            "name": "output",
            "values": [
              {
                "id": "ac1",
                "title": {
                  "en": "1"
                }
              },
              {
                "id": "ac2",
                "title": {
                  "en": "2"
                }
              }
            ]
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "on"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "off"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_backup_reserve",
        "title": {
          "en": "Set backup reserve level"
        },
        "titleFormatted": {
          "en": "Set backup reserve to [[level]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "number",
            "name": "level",
            "min": 3,
            "max": 95,
            "step": 1,
            "placeholder": {
              "en": "%"
            }
          }
        ]
      },
      {
        "id": "set_feed_in",
        "title": {
          "en": "Set grid feed-in"
        },
        "titleFormatted": {
          "en": "Turn grid feed-in [[state]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "dropdown",
            "name": "state",
            "values": [
              {
                "id": "on",
                "title": {
                  "en": "on"
                }
              },
              {
                "id": "off",
                "title": {
                  "en": "off"
                }
              }
            ]
          }
        ]
      },
      {
        "id": "set_operating_mode",
        "title": {
          "en": "Set operating mode"
        },
        "titleFormatted": {
          "en": "Set operating mode to [[mode]]"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "dropdown",
            "name": "mode",
            "values": [
              {
                "id": "self_powered",
                "title": {
                  "en": "Self-powered"
                }
              },
              {
                "id": "ai",
                "title": {
                  "en": "AI / Smart scheduling"
                }
              },
              {
                "id": "scheduled",
                "title": {
                  "en": "Scheduled"
                }
              },
              {
                "id": "tou",
                "title": {
                  "en": "Time-of-use"
                }
              }
            ]
          }
        ]
      }
    ]
  },
  "drivers": [
    {
      "name": {
        "en": "STREAM"
      },
      "class": "battery",
      "connectivity": [
        "cloud"
      ],
      "capabilities": [
        "measure_battery",
        "measure_power",
        "measure_power.pv",
        "measure_power.grid",
        "measure_power.load",
        "meter_power.charged",
        "meter_power.discharged",
        "measure_temperature",
        "measure_voltage",
        "battery_soh",
        "charge_limit",
        "discharge_limit",
        "onoff.ac1",
        "onoff.ac2",
        "backup_reserve_soc",
        "operating_mode",
        "feed_in_control"
      ],
      "capabilitiesOptions": {
        "measure_power": {
          "title": {
            "en": "Battery power"
          }
        },
        "measure_power.pv": {
          "title": {
            "en": "Solar power"
          }
        },
        "measure_power.grid": {
          "title": {
            "en": "Grid power"
          }
        },
        "measure_power.load": {
          "title": {
            "en": "Home load"
          }
        },
        "meter_power.charged": {
          "title": {
            "en": "Energy charged"
          }
        },
        "meter_power.discharged": {
          "title": {
            "en": "Energy discharged"
          }
        },
        "onoff.ac1": {
          "title": {
            "en": "AC output 1"
          },
          "insightsTitleTrue": {
            "en": "AC1 turned on"
          },
          "insightsTitleFalse": {
            "en": "AC1 turned off"
          }
        },
        "onoff.ac2": {
          "title": {
            "en": "AC output 2"
          },
          "insightsTitleTrue": {
            "en": "AC2 turned on"
          },
          "insightsTitleFalse": {
            "en": "AC2 turned off"
          }
        }
      },
      "images": {
        "small": "/drivers/stream/assets/images/small.png",
        "large": "/drivers/stream/assets/images/large.png",
        "xlarge": "/drivers/stream/assets/images/xlarge.png"
      },
      "energy": {
        "batteries": [
          "INTERNAL"
        ]
      },
      "pair": [
        {
          "id": "credentials"
        },
        {
          "id": "list_devices",
          "template": "list_devices",
          "navigation": {
            "next": "add_devices"
          }
        },
        {
          "id": "add_devices",
          "template": "add_devices"
        }
      ],
      "id": "stream"
    }
  ],
  "capabilities": {
    "backup_reserve_soc": {
      "type": "number",
      "title": {
        "en": "Backup reserve"
      },
      "units": {
        "en": "%"
      },
      "decimals": 0,
      "min": 3,
      "max": 95,
      "step": 1,
      "getable": true,
      "setable": true,
      "uiComponent": "slider",
      "insights": true
    },
    "battery_soh": {
      "type": "number",
      "title": {
        "en": "Battery health"
      },
      "units": {
        "en": "%"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "charge_limit": {
      "type": "number",
      "title": {
        "en": "Charge limit"
      },
      "units": {
        "en": "%"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "discharge_limit": {
      "type": "number",
      "title": {
        "en": "Discharge limit"
      },
      "units": {
        "en": "%"
      },
      "decimals": 0,
      "getable": true,
      "setable": false,
      "uiComponent": "sensor",
      "insights": true
    },
    "feed_in_control": {
      "type": "boolean",
      "title": {
        "en": "Grid feed-in"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "toggle",
      "insights": true,
      "insightsTitleTrue": {
        "en": "Feed-in enabled"
      },
      "insightsTitleFalse": {
        "en": "Feed-in disabled"
      }
    },
    "operating_mode": {
      "type": "enum",
      "title": {
        "en": "Operating mode"
      },
      "getable": true,
      "setable": true,
      "uiComponent": "picker",
      "values": [
        {
          "id": "self_powered",
          "title": {
            "en": "Self-powered"
          }
        },
        {
          "id": "ai",
          "title": {
            "en": "AI / Smart scheduling"
          }
        },
        {
          "id": "scheduled",
          "title": {
            "en": "Scheduled"
          }
        },
        {
          "id": "tou",
          "title": {
            "en": "Time-of-use"
          }
        }
      ]
    }
  }
}
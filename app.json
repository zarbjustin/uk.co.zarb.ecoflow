  "flow": {
    "triggers": [
      {
        "id": "battery_level_crossed",
        "title": {
          "en": "Battery level crossed"
        },
        "titleFormatted": {
          "en": "Battery level goes [[direction]] [[level]]%"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "dropdown",
            "name": "direction",
            "values": [
              {
                "id": "above",
                "title": {
                  "en": "above"
                }
              },
              {
                "id": "below",
                "title": {
                  "en": "below"
                }
              }
            ]
          },
          {
            "type": "number",
            "name": "level",
            "min": 0,
            "max": 100,
            "step": 1,
            "placeholder": {
              "en": "%"
            }
          }
        ],
        "tokens": [
          {
            "name": "battery",
            "type": "number",
            "title": {
              "en": "Battery"
            },
            "example": 20
          }
        ]
      },
      {
        "id": "charging_started",
        "title": {
          "en": "Battery started charging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Battery power"
            },
            "example": 800
          }
        ]
      },
      {
        "id": "device_came_online",
        "title": {
          "en": "Device came online"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ]
      },
      {
        "id": "device_went_offline",
        "title": {
          "en": "Device went offline"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ]
      },
      {
        "id": "discharging_started",
        "title": {
          "en": "Battery started discharging"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ],
        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Battery power"
            },
            "example": -600
          }
        ]
      },
      {
        "id": "fault_cleared",
        "title": {
          "en": "A fault was cleared"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ]
      },
      {
        "id": "fault_raised",
        "title": {
          "en": "A fault was raised"
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          }
        ],
        "tokens": [
          {
            "name": "source",
            "type": "string",
            "title": {
              "en": "Source"
            },
            "example": "inverter"
          },
          {
            "name": "code",
            "type": "number",
            "title": {
              "en": "Code"
            },
            "example": 4096
          }
        ]
      },
      {
        "id": "grid_export_started",

        "tokens": [
          {
            "name": "power",
            "type": "number",
            "title": {
              "en": "Grid power"
            },
            "example": 700
          }
        ]
      },
      {
        "id": "grid_power_changed",
        "title": {
          "en": "Grid power changed"
        },
        "titleFormatted": {
          "en": "Grid power changed"
        },

    "actions": [
      {
        "id": "prepare_for_cheap_import",
        "title": {
          "en": "Prepare for cheap grid import"
        },
        "titleFormatted": {
          "en": "Prepare for cheap import (charge to [[reserve]]%)"
        },
        "hint": {
          "en": "Lifts the charge limit to 100% and sets the backup reserve target so the battery charges from the grid during a cheap window (e.g. Octopus Agile)."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "number",
            "name": "reserve",
            "min": 3,
            "max": 95,
            "step": 1,
            "placeholder": {
              "en": "%"
            }
          }
        ]
      },
      {
        "id": "prepare_for_peak_export",
        "title": {
          "en": "Prepare for peak / export"
        },
        "titleFormatted": {
          "en": "Prepare for peak export (reserve [[reserve]]%)"
        },
        "hint": {
          "en": "Lowers the backup reserve so the battery can discharge and enables grid feed-in, to export during a high-price window."
        },
        "args": [
          {
            "type": "device",
            "name": "device",
            "filter": "driver_id=stream"
          },
          {
            "type": "number",
            "name": "reserve",
            "min": 3,
            "max": 95,
            "step": 1,
            "placeholder": {
              "en": "%"
            }
          }
        ]
      },
      {
        "id": "refresh_now",
        "title": {
          "en": "Refresh data now"

{
  "_comment": "This file is generated. Please edit .homeycompose/app.json instead.",
  "id": "uk.co.zarb.ecoflow",
  "version": "1.0.0",
  "compatibility": ">=12.4.0",
  "sdk": 3,
  "runtime": "nodejs",
  "platforms": [
    "local"
  ],
  "name": {
    "en": "EcoFlow - Balcony Solar"
  },

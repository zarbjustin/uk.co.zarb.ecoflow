  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Device information",
        "de": "Geräteinformationen",
        "nl": "Apparaatinformatie"
      },
      "children": [
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model",
            "de": "Modell",
            "nl": "Model"
          },
          "value": "—",
          "hint": {
            "en": "Detected from the serial number prefix (ES22).",
            "de": "Erkannt anhand des Seriennummern-Präfixes (ES22).",
            "nl": "Gedetecteerd via het serienummervoorvoegsel (ES22)."
          }
        },
        {
          "id": "serial_number",
          "type": "label",
          "label": {
            "en": "Serial number",
            "de": "Seriennummer",
            "nl": "Serienummer"
          },
          "value": "—",
          "hint": {
            "en": "This unit's EcoFlow serial number.",
            "de": "Die EcoFlow-Seriennummer dieser Einheit.",
            "nl": "Het EcoFlow-serienummer van deze unit."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "Experimental connection",
        "de": "Experimentelle Verbindung",
        "nl": "Experimentele verbinding"
      },
      "children": [
        {
          "id": "unavailable_after",
          "type": "number",
          "label": {
            "en": "Report offline after (minutes)",
            "de": "Als offline melden nach (Minuten)",
            "nl": "Als offline melden na (minuten)"
          },
          "value": 20,
          "min": 5,
          "max": 240,
          "hint": {
            "en": "This device is monitored over EcoFlow's app connection only — there is no REST polling. If no data arrives within this many minutes the device is shown as unavailable.",
            "de": "Dieses Gerät wird ausschließlich über die App-Verbindung von EcoFlow überwacht — es gibt kein REST-Polling. Treffen innerhalb dieser Minutenzahl keine Daten ein, wird das Gerät als nicht verfügbar angezeigt.",
            "nl": "Dit apparaat wordt alleen via de app-verbinding van EcoFlow gevolgd — er is geen REST-polling. Komen er binnen dit aantal minuten geen gegevens binnen, dan wordt het apparaat als niet beschikbaar getoond."
          }
        },
        {
          "id": "experimental_notice",
          "type": "label",
          "label": {
            "en": "Status",
            "de": "Status",
            "nl": "Status"
          },
          "value": "Experimental · monitoring only · controls intentionally disabled",
          "hint": {
            "en": "EcoFlow publishes no supported API for the STREAM AC 5000, so this integration signs in with your EcoFlow account and only reads data. Controls are deliberately not implemented until the read path is validated on hardware.",
            "de": "EcoFlow bietet keine unterstützte API für den STREAM AC 5000, daher meldet sich diese Integration mit deinem EcoFlow-Konto an und liest ausschließlich Daten. Steuerbefehle sind bewusst nicht implementiert, bis der Lesepfad an Hardware validiert ist.",
            "nl": "EcoFlow biedt geen ondersteunde API voor de STREAM AC 5000, dus deze integratie logt in met je EcoFlow-account en leest alleen gegevens. Bediening is bewust niet geïmplementeerd totdat het leespad op hardware is gevalideerd."
          }
        }
      ]
    }
  ],
  "pair": [

  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Device information",
        "de": "Geräteinformationen",
        "nl": "Apparaatinformatie"
      },
      "children": [
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model",
            "de": "Modell",
            "nl": "Model"
          },
          "value": "—",
          "hint": {
            "en": "Detected from the serial number prefix (ES22).",
            "de": "Erkannt anhand des Seriennummern-Präfixes (ES22).",
            "nl": "Gedetecteerd via het serienummervoorvoegsel (ES22)."
          }
        },
        {
          "id": "serial_number",
          "type": "label",
          "label": {
            "en": "Serial number",
            "de": "Seriennummer",
            "nl": "Serienummer"
          },
          "value": "—",
          "hint": {
            "en": "This unit's EcoFlow serial number.",
            "de": "Die EcoFlow-Seriennummer dieser Einheit.",
            "nl": "Het EcoFlow-serienummer van deze unit."
          }
        }
      ]
    },
    {
      "type": "group",
      "label": {
        "en": "EcoFlow app connection",
        "de": "EcoFlow-App-Verbindung",
        "nl": "EcoFlow-appverbinding"
      },
      "children": [
        {
          "id": "unavailable_after",
          "type": "number",
          "label": {
            "en": "Report offline after (minutes)",
            "de": "Als offline melden nach (Minuten)",
            "nl": "Als offline melden na (minuten)"
          },
          "value": 20,
          "min": 5,
          "max": 240,
          "hint": {
            "en": "This device is monitored over EcoFlow's app connection only — there is no REST polling. If no data arrives within this many minutes the device is shown as unavailable.",
            "de": "Dieses Gerät wird ausschließlich über die App-Verbindung von EcoFlow überwacht — es gibt kein REST-Polling. Treffen innerhalb dieser Minutenzahl keine Daten ein, wird das Gerät als nicht verfügbar angezeigt.",
            "nl": "Dit apparaat wordt alleen via de app-verbinding van EcoFlow gevolgd — er is geen REST-polling. Komen er binnen dit aantal minuten geen gegevens binnen, dan wordt het apparaat als niet beschikbaar getoond."
          }
        },
        {
          "id": "diagnostic_capture_next",
          "type": "checkbox",
          "label": {
            "en": "Capture next telemetry snapshot",
            "de": "Nächsten Telemetrie-Snapshot erfassen",
            "nl": "Volgende telemetrie-snapshot vastleggen"
          },
          "value": false,
          "hint": {
            "en": "Enable this immediately before taking comparison screenshots. The next AC 5000 telemetry cycle is added to the diagnostic log without credentials or a complete serial number, then this option switches off automatically.",
            "de": "Aktivieren Sie dies unmittelbar vor Vergleichs-Screenshots. Der nächste AC-5000-Telemetriezyklus wird ohne Zugangsdaten oder vollständige Seriennummer zum Diagnoseprotokoll hinzugefügt; danach schaltet sich diese Option automatisch aus.",
            "nl": "Schakel dit direct voor vergelijkende screenshots in. De volgende AC 5000-telemetriecyclus wordt zonder inloggegevens of volledig serienummer aan het diagnoselogboek toegevoegd; daarna wordt deze optie automatisch uitgeschakeld."
          }
        },
        {
          "id": "experimental_notice",
          "type": "label",
          "label": {
            "en": "Status",
            "de": "Status",
            "nl": "Status"
          },
          "value": "Monitoring only · controls intentionally disabled",
          "hint": {
            "en": "EcoFlow provides no supported public API for the STREAM AC 5000, so this integration signs in through EcoFlow's app connection and only reads data. Controls are intentionally disabled.",
            "de": "EcoFlow bietet keine unterstützte öffentliche API für den STREAM AC 5000. Daher meldet sich diese Integration über die EcoFlow-App-Verbindung an und liest ausschließlich Daten. Steuerbefehle sind bewusst deaktiviert.",
            "nl": "EcoFlow biedt geen ondersteunde openbare API voor de STREAM AC 5000. Daarom meldt deze integratie zich aan via de EcoFlow-appverbinding en leest alleen gegevens. Bediening is bewust uitgeschakeld."
          }
        }
      ]
    }
  ],
  "pair": [
    {
      "id": "app_credentials"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}

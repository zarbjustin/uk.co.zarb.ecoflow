{
  "name": { "en": "Smart Meter" },
  "class": "sensor",
  "connectivity": ["cloud"],
  "capabilities": [
    "measure_power",
    "meter_power.imported",
    "meter_power.exported"
  ],
  "capabilitiesOptions": {
    "measure_power": { "title": { "en": "Grid power" } },
    "meter_power.imported": { "title": { "en": "Imported" } },
    "meter_power.exported": { "title": { "en": "Exported" } }
  },
  "energy": {
    "cumulative": true,
    "cumulativeImportedCapability": "meter_power.imported",
    "cumulativeExportedCapability": "meter_power.exported"
  },
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Polling interval (seconds)" },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": { "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls." }
    }
  ],
  "images": {
    "small": "/drivers/smartmeter/assets/images/small.png",
    "large": "/drivers/smartmeter/assets/images/large.png",
    "xlarge": "/drivers/smartmeter/assets/images/xlarge.png"
  },
  "pair": [
    { "id": "credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}

{
  "name": {
    "en": "Smart Meter",
    "de": "Smart Meter",
    "nl": "Smart Meter"
  },
  "class": "sensor",
  "platforms": [
    "local"
  ],
  "connectivity": [
    "cloud"
  ],
  "capabilities": [
    "measure_power",
    "smartmeter_power_grid",
    "smartmeter_power_import",
    "smartmeter_power_export",
    "meter_power.imported",
    "meter_power.exported"
  ],
  "capabilitiesOptions": {
    "measure_power": {
      "title": {
        "en": "Grid power",
        "de": "Netzleistung",
        "nl": "Netvermogen"
      }
    },
    "meter_power.imported": {
      "title": {
        "en": "Imported",
        "de": "Bezogen",
        "nl": "Afgenomen"
      }
    },
    "meter_power.exported": {
      "title": {
        "en": "Exported",
        "de": "Eingespeist",
        "nl": "Teruggeleverd"
      }
    }
  },
  "energy": {
    "cumulative": true,
    "cumulativeImportedCapability": "meter_power.imported",
    "cumulativeExportedCapability": "meter_power.exported"
  },
  "settings": [
    {
      "id": "meter_source",
      "type": "dropdown",
      "label": {
        "en": "Additional home-load reading",
        "de": "Zusätzlicher Hausverbrauchswert",
        "nl": "Extra huisverbruikswaarde"
      },
      "value": "grid",
      "values": [
        {
          "id": "grid",
          "label": {
            "en": "Grid readings only",
            "de": "Nur Netzwerte",
            "nl": "Alleen netwaarden"
          }
        },
        {
          "id": "load",
          "label": {
            "en": "Also show home load when available",
            "de": "Hausverbrauch anzeigen, wenn verfügbar",
            "nl": "Ook huisverbruik tonen indien beschikbaar"
          }
        }
      ],
      "hint": {
        "en": "Homey Energy always uses grid power (import positive, export negative). Home load is an optional separate reading from the linked STREAM installation, not another CT channel.",
        "de": "Homey Energy nutzt immer die Netzleistung (Bezug positiv, Einspeisung negativ). Hausverbrauch ist ein optionaler separater Wert der STREAM-Anlage, kein zusätzlicher CT-Kanal.",
        "nl": "Homey Energy gebruikt altijd netvermogen (afname positief, teruglevering negatief). Huisverbruik is een optionele aparte waarde van de STREAM-installatie, geen extra CT-kanaal."
      }
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": {
        "en": "Polling interval (seconds)",
        "de": "Abfrageintervall (Sekunden)",
        "nl": "Poll-interval (seconden)"
      },
      "value": 15,
      "min": 10,
      "max": 600,
      "hint": {
        "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls.",
        "de": "Wie oft Daten per REST abgerufen werden. MQTT liefert Echtzeit-Updates zwischen den Abfragen.",
        "nl": "Hoe vaak gegevens via REST worden opgehaald. MQTT levert realtime updates tussen polls."
      }
    }
  ],
  "images": {
    "small": "/drivers/smartmeter/assets/images/small.png",
    "large": "/drivers/smartmeter/assets/images/large.png",
    "xlarge": "/drivers/smartmeter/assets/images/xlarge.png"
  },
  "pair": [
    {
      "id": "credentials"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}

{
  "name": { "en": "STREAM Unit" },
  "class": "battery",
  "connectivity": ["cloud"],
  "capabilities": [
    "measure_battery",
    "battery_charging_state",
    "operating_mode",
    "stream_unit_power_battery_flow",
    "measure_power.load",
    "stream_unit_power_grid",
    "stream_unit_power_solar",
    "stream_unit_power_from_solar",
    "stream_unit_power_from_battery",
    "stream_unit_power_from_grid",
    "onoff.ac1",
    "onoff.ac2",
    "stream_unit_power_ac1",
    "stream_unit_power_ac2",
    "backup_reserve_soc",
    "charge_limit",
    "discharge_limit",
    "feed_in_control",
    "charge_remaining",
    "discharge_remaining",
    "stream_unit_power_pv1",
    "stream_unit_power_pv2",
    "stream_unit_power_pv3",
    "stream_unit_power_pv4",
    "measure_temperature",
    "battery_soh",
    "battery_cycles"
  ],
  "capabilitiesOptions": {
    "measure_battery": { "title": { "en": "Battery" } },
    "battery_charging_state": { "title": { "en": "Battery state" } },
    "operating_mode": { "title": { "en": "Mode" } },
    "measure_power.load": { "title": { "en": "House consumption" } },
    "onoff.ac1": { "title": { "en": "AC output 1" } },
    "onoff.ac2": { "title": { "en": "AC output 2" } },
    "backup_reserve_soc": { "title": { "en": "Backup reserve" } },
    "charge_limit": { "title": { "en": "Charge limit" } },
    "discharge_limit": { "title": { "en": "Discharge limit" } },
    "feed_in_control": { "title": { "en": "Grid feed-in" } },
    "charge_remaining": { "title": { "en": "Time to full" } },
    "discharge_remaining": { "title": { "en": "Time to empty" } },
    "measure_temperature": { "title": { "en": "Battery temperature" } },
    "battery_soh": { "title": { "en": "Battery health" } },
    "battery_cycles": { "title": { "en": "Battery cycles" } }
  },
  "energy": {
    "batteries": ["INTERNAL"]
  },
  "images": {
    "small": "/drivers/stream_unit/assets/images/small.png",
    "large": "/drivers/stream_unit/assets/images/large.png",
    "xlarge": "/drivers/stream_unit/assets/images/xlarge.png"
  },
  "settings": [
    {
      "type": "group",
      "label": { "en": "Device information" },
      "children": [
        {
          "id": "model",
          "type": "label",
          "label": { "en": "Model" },
          "value": "—",
          "hint": { "en": "The specific STREAM product this unit is, detected from its serial number." }
        },
        {
          "id": "serial_number",
          "type": "label",
          "label": { "en": "Serial number" },
          "value": "—",
          "hint": { "en": "This physical unit's EcoFlow serial number." }
        },
        {
          "id": "system_role",
          "type": "label",
          "label": { "en": "Role in system" },
          "value": "—",
          "hint": { "en": "Whether this unit is the system's main unit (which reports whole-home totals and system controls) or a member unit." }
        },
        {
          "id": "power_source",
          "type": "label",
          "label": { "en": "Energy source" },
          "value": "—",
          "hint": { "en": "How this model is powered. AC-coupled units (e.g. STREAM AC Pro) have no direct solar input." }
        },
        {
          "id": "ac_output",
          "type": "label",
          "label": { "en": "AC output" },
          "value": "—",
          "hint": { "en": "Rated AC output for this model. Ultra/Ultra X support a higher paired (parallel) output when two units are linked." }
        }
      ]
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Polling interval (seconds)" },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": { "en": "How often to fetch this unit's data over REST. MQTT delivers realtime updates between polls." }
    }
  ],
  "pair": [
    { "id": "credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}

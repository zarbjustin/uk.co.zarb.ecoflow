  "settings": [
    {
      "type": "group",
      "label": {
        "en": "Device information",
        "de": "Geräteinformationen",
        "nl": "Apparaatinformatie"
      },
      "children": [
        {
          "id": "model",
          "type": "label",
          "label": {
            "en": "Model",
            "de": "Modell",
            "nl": "Model"
          },
          "value": "—",
          "hint": {
            "en": "The specific STREAM product this unit is, detected from its serial number.",
            "de": "Das genaue STREAM-Produkt dieser Einheit, erkannt anhand der Seriennummer.",
            "nl": "Het specifieke STREAM-product van deze unit, gedetecteerd via het serienummer."
          }
        },
        {
          "id": "serial_number",
          "type": "label",
          "label": {
            "en": "Serial number",
            "de": "Seriennummer",
            "nl": "Serienummer"
          },
          "value": "—",
          "hint": {
            "en": "This physical unit's EcoFlow serial number.",
            "de": "Die EcoFlow-Seriennummer dieser physischen Einheit.",
            "nl": "Het EcoFlow-serienummer van deze fysieke unit."
          }
        },
        {
          "id": "system_role",
          "type": "label",
          "label": {
            "en": "Role in system",
            "de": "Rolle im System",
            "nl": "Rol in systeem"
          },
          "value": "—",
          "hint": {
            "en": "Whether this unit is the system's main unit (which reports whole-home totals and system controls) or a member unit.",
            "de": "Ob diese Einheit die Haupteinheit des Systems ist (meldet Gesamtdaten des Hauses und Systemsteuerungen) oder eine Mitgliedseinheit.",
            "nl": "Of deze unit de hoofdeenheid van het systeem is (rapporteert totalen voor het hele huis en systeembediening) of een deelnemende unit."
          }
        },
        {
          "id": "power_source",
          "type": "label",
          "label": {
            "en": "Energy source",
            "de": "Energiequelle",
            "nl": "Energiebron"
          },
          "value": "—",
          "hint": {
            "en": "How this model is powered. AC-coupled units (e.g. STREAM AC Pro) have no direct solar input.",
            "de": "Wie dieses Modell mit Energie versorgt wird. AC-gekoppelte Einheiten (z. B. STREAM AC Pro) haben keinen direkten Solareingang.",
            "nl": "Hoe dit model wordt gevoed. AC-gekoppelde units (bijv. STREAM AC Pro) hebben geen directe zonne-ingang."
          }
        },
        {
          "id": "ac_output",
          "type": "label",
          "label": {
            "en": "AC output",
            "de": "AC-Ausgang",
            "nl": "AC-uitgang"
          },
          "value": "—",
          "hint": {
            "en": "Rated AC output for this model. Ultra/Ultra X support a higher paired (parallel) output when two units are linked.",
            "de": "Nennleistung des AC-Ausgangs für dieses Modell. Ultra/Ultra X unterstützen eine höhere gekoppelte (parallele) Leistung, wenn zwei Einheiten verbunden sind.",
            "nl": "Nominaal AC-uitgangsvermogen voor dit model. Ultra/Ultra X ondersteunen een hoger gekoppeld (parallel) vermogen wanneer twee units zijn gekoppeld."
          }
        }
      ]
    },
    {
      "id": "poll_interval",
      "type": "number",
      "label": {
        "en": "Polling interval (seconds)",
        "de": "Abfrageintervall (Sekunden)",
        "nl": "Poll-interval (seconden)"
      },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": {
        "en": "How often to fetch this unit's data over REST. MQTT delivers realtime updates between polls.",
        "de": "Wie oft die Daten dieser Einheit per REST abgerufen werden. MQTT liefert Echtzeit-Updates zwischen den Abfragen.",
        "nl": "Hoe vaak gegevens van deze unit via REST worden opgehaald. MQTT levert realtime updates tussen polls."
      }
    }
  ],
  "pair": [
    {
      "id": "credentials"
    },
    {
      "id": "list_devices",

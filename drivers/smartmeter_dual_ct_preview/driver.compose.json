  "settings": [
    {
      "id": "preview_enabled",
      "type": "checkbox",
      "value": false,
      "label": {
        "en": "Receive meter readings",
        "de": "Messwerte empfangen",
        "nl": "Meterstanden ontvangen"
      },
      "hint": {
        "en": "Shows CT1/CT2 readings. Homey Energy accounting is not enabled on this device. Circuit descriptions change labels only. Measurement mapping, direction and timing are still being validated; do not use these readings for automation. Disabling clears readings and disconnects this device listener. Use Repair after updating the shared EcoFlow sign-in.",
        "de": "Zeigt CT1/CT2-Messwerte. Homey Energy ist für dieses Gerät nicht aktiviert. Stromkreisbeschreibungen ändern nur die Beschriftung. Zuordnung, Richtung und Zeitbezug werden noch geprüft; diese Werte nicht zur Automatisierung verwenden. Deaktivieren löscht Werte und trennt diesen Listener. Nach Änderung der gemeinsamen EcoFlow-Anmeldung Reparieren verwenden.",
        "nl": "Toont CT1/CT2-metingen. Homey Energy is niet ingeschakeld voor dit apparaat. Circuitbeschrijvingen wijzigen alleen labels. Meetkoppeling, richting en tijdsbasis worden nog gevalideerd; gebruik deze waarden niet voor automatisering. Uitschakelen wist waarden en koppelt deze listener los. Gebruik Repareren na het bijwerken van de gedeelde EcoFlow-aanmelding."
      }
    },
    {
      "id": "ct1_role",
      "type": "dropdown",
      "value": "unknown",
      "label": {
        "en": "CT1 circuit description",
        "de": "CT1 Stromkreisbeschreibung",
        "nl": "CT1 circuitbeschrijving"
      },
      "hint": {
        "en": "Display only: choose what this port measures in your installation. Does not select an Energy source, invert signs or verify a mapping. A hybrid inverter includes solar and battery exchange; it is not solar-only production.",
        "de": "Nur Anzeige: Wählen Sie den Stromkreis dieses Anschlusses. Keine Energiequelle, Vorzeichenumkehr oder bestätigte Zuordnung. Ein Hybridwechselrichter umfasst Solar- und Batterieaustausch, nicht nur Solarerzeugung.",
        "nl": "Alleen weergave: kies wat deze poort meet. Geen selectie van Energy-bron, tekenomkering of geverifieerde koppeling. Een hybride omvormer omvat zon en batterij, niet alleen zonneproductie."
      },
      "values": [
        {
          "id": "unknown",
          "label": {
            "en": "Not specified",
            "de": "Nicht angegeben",
            "nl": "Niet opgegeven"
          }
        },
        {
          "id": "grid",
          "label": {
            "en": "Grid connection",
            "de": "Netzanschluss",
            "nl": "Netaansluiting"
          }
        },
        {
          "id": "hybrid_inverter",
          "label": {
            "en": "Hybrid inverter (solar + battery)",
            "de": "Hybridwechselrichter (Solar + Batterie)",
            "nl": "Hybride omvormer (zon + batterij)"
          }
        },
        {
          "id": "solar_inverter",
          "label": {
            "en": "Solar-only inverter",
            "de": "Reiner Solarwechselrichter",
            "nl": "Omvormer voor alleen zon"
          }
        },
        {

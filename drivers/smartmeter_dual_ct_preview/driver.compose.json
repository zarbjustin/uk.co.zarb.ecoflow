  "settings": [
    {
      "id": "preview_enabled",
      "type": "checkbox",
      "value": false,
      "label": {
        "en": "Enable continuous read-only preview",
        "de": "Kontinuierliche Nur-Lese-Vorschau aktivieren",
        "nl": "Continue alleen-lezenpreview inschakelen"
      },
      "hint": {
        "en": "CT1/CT2 and V/A/W use community comparisons, not a verified contract. Ages are since receipt; fields need not be simultaneous. Totals/counters remain raw. No Energy, Flows, tags or Insights. Disabling clears readings and detaches this listener. After an account change, disable and re-enable to recheck the original account; a different account requires re-pairing this preview only.",
        "de": "CT1/CT2 und V/A/W beruhen auf Community-Vergleichen, keinem verifizierten Vertrag. Alter seit Empfang; Felder nicht zwingend gleichzeitig. Summen/Zähler bleiben roh. Keine Energie, Flows, Tags oder Insights. Deaktivieren löscht Werte und Listener. Nach Kontowechsel aus-/einschalten, um das ursprüngliche Konto zu prüfen; ein anderes Konto erfordert erneute Kopplung nur dieser Vorschau.",
        "nl": "CT1/CT2 en V/A/W volgen communityvergelijkingen, geen geverifieerd contract. Leeftijd sinds ontvangst; velden niet noodzakelijk gelijktijdig. Totalen/tellers blijven ruw. Geen Energy, Flows, tags of Insights. Uitschakelen wist waarden en deze listener. Na accountwijziging uit- en inschakelen om het oorspronkelijke account te controleren; een ander account vereist opnieuw koppelen van alleen deze preview."
      }
    },
    {
      "id": "ct1_role",
      "type": "dropdown",
      "value": "unknown",
      "label": {
        "en": "CT1 circuit description",
        "de": "CT1 Stromkreisbeschreibung",
        "nl": "CT1 circuitbeschrijving"
      },
      "hint": {
        "en": "Display only: choose what this port measures in your installation. Does not select an Energy source, invert signs or verify a mapping. A hybrid inverter includes solar and battery exchange; it is not solar-only production.",
        "de": "Nur Anzeige: Wählen Sie den Stromkreis dieses Anschlusses. Keine Energiequelle, Vorzeichenumkehr oder bestätigte Zuordnung. Ein Hybridwechselrichter umfasst Solar- und Batterieaustausch, nicht nur Solarerzeugung.",
        "nl": "Alleen weergave: kies wat deze poort meet. Geen selectie van Energy-bron, tekenomkering of geverifieerde koppeling. Een hybride omvormer omvat zon en batterij, niet alleen zonneproductie."
      },
      "values": [
        {
          "id": "unknown",
          "label": {
            "en": "Not specified",
            "de": "Nicht angegeben",
            "nl": "Niet opgegeven"

  "settings": [
    {
      "id": "paired_mode_summary",
      "type": "label",
      "label": {
        "en": "Paired Energy mode",
        "de": "Gekoppelter Energy-Modus",
        "nl": "Gekoppelde Energy-modus"
      },
      "value": "—",
      "hint": {
        "en": "Recorded at pairing. The phase display settings below do not change this accounting mode. CT2 is never added to property grid totals.",
        "de": "Beim Koppeln festgelegt. Die Phasenanzeige unten ändert diesen Berechnungsmodus nicht. CT2 wird nie zur Netzbilanz addiert.",
        "nl": "Vastgelegd bij koppelen. De faseweergave hieronder verandert deze berekening niet. CT2 wordt nooit bij het netverbruik opgeteld."
      }
    },
    {
      "id": "display_ct1",
      "type": "dropdown",
      "value": "default",
      "label": {
        "en": "CT1 phase display",
        "de": "CT1 Phasenanzeige",
        "nl": "CT1 faseweergave"
      },
      "hint": {
        "en": "Display only. Does not change your Energy source, accounting mode, signs or counters. Hidden readings remain available internally; no history or Flow references are removed. Default keeps the monitor layout or follows the paired Energy mode. Details use independently received readings for up to 90 seconds; Energy power keeps its stricter freshness checks. Reopen the device view after saving.",
        "de": "Nur Anzeige. Ändert weder Energy-Quelle, Abrechnung, Vorzeichen noch Zähler. Ausgeblendete Werte bleiben intern erhalten; Verlauf und Flow-Verweise werden nicht entfernt. Standard behält die Monitoransicht bzw. folgt dem gekoppelten Energy-Modus. Details zeigen separat empfangene Werte bis zu 90 Sekunden lang; Energy-Leistung behält ihre strengeren Aktualitätsprüfungen. Geräteansicht nach dem Speichern erneut öffnen.",
        "nl": "Alleen weergave. Wijzigt geen Energy-bron, rekenmethode, tekens of tellers. Verborgen waarden blijven intern beschikbaar; geschiedenis en Flow-verwijzingen blijven behouden. Standaard behoudt de monitorweergave of volgt de gekoppelde Energy-modus. Details tonen afzonderlijk ontvangen waarden tot 90 seconden; Energy-vermogen behoudt zijn strengere actualiteitscontroles. Open de apparaatweergave opnieuw na opslaan."
      },
      "values": [
        {
          "id": "default",
          "label": {
            "en": "Default layout",
            "de": "Standardansicht",
            "nl": "Standaardweergave"
          }
        },
        {
          "id": "single_phase",
          "label": {
            "en": "Single phase",
            "de": "Einphasig",
            "nl": "Eenfase"
          }
        },
        {
          "id": "three_phase",
          "label": {
            "en": "Three phase",
            "de": "Dreiphasig",
            "nl": "Driefase"
          }
        }
      ]
    },
    {
      "id": "display_ct2",
      "type": "dropdown",
      "value": "default",
      "label": {
        "en": "CT2 display",
        "de": "CT2 Anzeige",
        "nl": "CT2 weergave"
      },
      "hint": {
        "en": "Choose Off, single phase or three phase for optional CT2 readings. CT2 does not contribute to whole-property Energy totals. Display changes preserve history and Flow references. Reopen the device after saving.",
        "de": "Wählen Sie Aus, einphasig oder dreiphasig für optionale CT2-Werte. CT2 trägt nicht zur Hausenergie bei. Anzeigeänderungen erhalten Verlauf und Flow-Verweise. Öffnen Sie das Gerät nach dem Speichern erneut.",
        "nl": "Kies Uit, één fase of drie fasen voor optionele CT2-metingen. CT2 telt niet mee in de woningenergie. Weergavewijzigingen behouden historie en Flow-verwijzingen. Open het apparaat opnieuw na opslaan."
      },
      "values": [
        {
          "id": "default",
          "label": {
            "en": "Default layout",
            "de": "Standardansicht",
            "nl": "Standaardweergave"
          }
        },
        {
          "id": "off",
          "label": {
            "en": "Hide CT2",
            "de": "CT2 ausblenden",
            "nl": "CT2 verbergen"
          }
        },
        {
          "id": "single_phase",
          "label": {
            "en": "Single phase",
            "de": "Einphasig",
            "nl": "Eenfase"
          }
        },
        {
          "id": "three_phase",
          "label": {
            "en": "Three phase",
            "de": "Dreiphasig",
            "nl": "Driefase"
          }
        }
      ]
    }

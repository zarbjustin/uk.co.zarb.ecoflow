{
  "name": { "en": "STREAM Socket" },
  "class": "socket",
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "capabilities": [
    "onoff",
    "measure_power"
  ],
  "images": {
    "small": "/drivers/stream_socket/assets/images/small.png",
    "large": "/drivers/stream_socket/assets/images/large.png",
    "xlarge": "/drivers/stream_socket/assets/images/xlarge.png"
  },
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Polling interval (seconds)" },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": { "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls." }
    }
  ],
  "pair": [
    { "id": "credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}

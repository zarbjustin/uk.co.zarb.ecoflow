  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": {
        "en": "Polling interval (seconds)",
        "de": "Abfrageintervall (Sekunden)",
        "nl": "Poll-interval (seconden)"
      },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": {
        "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls.",
        "de": "Wie oft Daten per REST abgerufen werden. MQTT liefert Echtzeit-Updates zwischen den Abfragen.",
        "nl": "Hoe vaak gegevens via REST worden opgehaald. MQTT levert realtime updates tussen polls."
      }
    },
    {
      "id": "enable_history",
      "type": "checkbox",
      "label": {
        "en": "Daily energy statistics",
        "de": "Tägliche Energiestatistik",
        "nl": "Dagelijkse energiestatistieken"
      },
      "value": true,
      "hint": {
        "en": "Fetch daily solar/grid/savings/CO₂ totals from EcoFlow's history API.",
        "de": "Tägliche Solar-, Netz-, Ersparnis- und CO₂-Summen aus der Verlaufs-API von EcoFlow abrufen.",
        "nl": "Haal dagelijkse totalen voor zonne-energie, net, besparing en CO₂ op uit EcoFlows historie-API."
      }
    },
    {
      "id": "history_prefix",
      "type": "text",
      "label": {
        "en": "History model code",
        "de": "Verlaufsmodellcode",
        "nl": "Historiemodelcode"
      },
      "value": "BK621",
      "hint": {
        "en": "EcoFlow history metric prefix for your STREAM model (default BK621). Change if daily stats stay empty.",
        "de": "EcoFlow-Verlaufsmetrik-Präfix für dein STREAM-Modell (Standard BK621). Ändere ihn, wenn die Tagesstatistik leer bleibt.",
        "nl": "EcoFlow-prefix voor historische meetwaarden van je STREAM-model (standaard BK621). Wijzig dit als dagstatistieken leeg blijven."
      }
    },
    {
      "id": "solar_forecast",
      "type": "checkbox",
      "label": {
        "en": "Solar forecast",
        "de": "Solarprognose",
        "nl": "Zonprognose"
      },
      "value": true,
      "hint": {
        "en": "Estimate today's and tomorrow's solar yield from the local weather forecast (Open-Meteo) at Homey's location.",
        "de": "Schätzt den heutigen und morgigen Solarertrag anhand der lokalen Wettervorhersage (Open-Meteo) am Standort von Homey.",
        "nl": "Schat de zonneopbrengst van vandaag en morgen op basis van de lokale weersverwachting (Open-Meteo) op de locatie van Homey."
      }
    },
    {
      "id": "solar_factor",
      "type": "number",
      "label": {
        "en": "Solar forecast factor (kWh per MJ/m²)",
        "de": "Solarprognose-Faktor (kWh pro MJ/m²)",
        "nl": "Zonprognosefactor (kWh per MJ/m²)"
      },
      "value": 0.67,
      "min": 0.05,
      "max": 5,
      "hint": {
        "en": "Tune to your array size: expected kWh per MJ/m² of daily solar radiation. Raise if the forecast reads low versus your actual solar, lower if it reads high.",
        "de": "An deine Anlagengröße anpassen: erwartete kWh pro MJ/m² täglicher Solarstrahlung. Erhöhen, wenn die Prognose zu niedrig ist, senken, wenn sie zu hoch ist.",
        "nl": "Stem af op je systeemgrootte: verwachte kWh per MJ/m² dagelijkse zonnestraling. Verhoog als de prognose te laag is, verlaag als deze te hoog is."
      }
    },
    {
      "id": "price_unit",
      "type": "text",
      "label": {
        "en": "Electricity price unit",
        "de": "Einheit des Strompreises",
        "nl": "Eenheid van de stroomprijs"
      },
      "value": "p/kWh",
      "hint": {
        "en": "Display unit for the electricity price you feed in via the 'Set electricity price' Flow action (e.g. p/kWh, ct/kWh). Feed the price from any tariff app (Octopus, Tibber, aWATTar, …).",
        "de": "Anzeigeeinheit für den Strompreis, den du über die Flow-Aktion 'Strompreis festlegen' einspeist (z. B. ct/kWh). Speise den Preis aus einer beliebigen Tarif-App ein (Tibber, aWATTar, Octopus, …).",
        "nl": "Weergave-eenheid voor de stroomprijs die je invoert via de Flow-actie 'Stroomprijs instellen' (bijv. ct/kWh). Voer de prijs in vanuit elke tarief-app (Tibber, aWATTar, Octopus, …)."
      }
    },
    {
      "id": "installed_capacity_kwh",
      "type": "number",
      "label": {
        "en": "Installed system capacity (kWh)",
        "de": "Installierte Systemkapazität (kWh)",
        "nl": "Geïnstalleerde systeemcapaciteit (kWh)"
      },
      "min": 0.1,
      "max": 200,
      "hint": {
        "en": "Optional total usable capacity of all batteries in this installation. EcoFlow's public API does not report this reliably. Used only for stored-energy and runtime estimates.",
        "de": "Optionale nutzbare Gesamtkapazität aller Batterien dieser Anlage. Die öffentliche EcoFlow-API meldet sie nicht zuverlässig. Wird nur für Energie- und Laufzeitschätzungen verwendet.",
        "nl": "Optionele totale bruikbare capaciteit van alle batterijen in deze installatie. De openbare EcoFlow-API meldt dit niet betrouwbaar. Alleen gebruikt voor energie- en looptijdschattingen."
      }
    },
    {
      "id": "discharge_efficiency_percent",
      "type": "number",
      "label": {
        "en": "Discharge efficiency (%)",
        "de": "Entladewirkungsgrad (%)",
        "nl": "Ontlaadrendement (%)"
      },
      "value": 92,
      "min": 50,
      "max": 100,
      "hint": {
        "en": "Efficiency applied to the calculated time-to-empty estimate. The default is 92%.",
        "de": "Wirkungsgrad für die berechnete Restlaufzeitschätzung. Standardwert: 92 %.",
        "nl": "Rendement voor de berekende schatting van de resterende looptijd. Standaard: 92%."
      }
    }
  ],
  "pair": [
    {
      "id": "credentials"
    },
    {
      "id": "list_devices",
      "template": "list_devices",
      "navigation": {
        "next": "add_devices"
      }
    },
    {
      "id": "add_devices",
      "template": "add_devices"
    }
  ]
}

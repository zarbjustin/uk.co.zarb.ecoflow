{
  "name": { "en": "STREAM" },
  "class": "battery",
  "platforms": ["local"],
  "connectivity": ["cloud"],
  "capabilities": [
    "measure_battery",
    "battery_charging_state",
    "operating_mode",
    "backup_reserve_soc",
    "charge_limit",
    "discharge_limit",
    "feed_in_control",
    "measure_power.load",
    "measure_power.pv",
    "measure_power.grid",
    "measure_power",
    "charge_remaining",
    "discharge_remaining",
    "meter_power.charged",
    "meter_power.discharged",
    "measure_power.pv1",
    "measure_power.pv2",
    "measure_power.pv3",
    "measure_power.pv4",
    "measure_power.schuko1",
    "measure_power.schuko2",
    "measure_power.from_pv",
    "measure_power.from_battery",
    "measure_power.from_grid",
    "measure_temperature",
    "measure_voltage",
    "battery_soh",
    "battery_cycles",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "measure_battery": { "title": { "en": "Battery" } },
    "battery_charging_state": { "title": { "en": "Battery state" } },
    "operating_mode": { "title": { "en": "Mode" } },
    "backup_reserve_soc": { "title": { "en": "Backup reserve" } },
    "charge_limit": { "title": { "en": "Charge limit" } },
    "discharge_limit": { "title": { "en": "Discharge limit" } },
    "feed_in_control": { "title": { "en": "Grid feed-in" } },
    "measure_power.load": { "title": { "en": "Home consumption" } },
    "measure_power.pv": { "title": { "en": "Solar generation" } },
    "measure_power.grid": { "title": { "en": "Grid import/export" } },
    "measure_power": { "title": { "en": "Battery flow" } },
    "charge_remaining": { "title": { "en": "Time to full" } },
    "discharge_remaining": { "title": { "en": "Time to empty" } },
    "meter_power.charged": { "title": { "en": "Charged total" } },
    "meter_power.discharged": { "title": { "en": "Discharged total" } },
    "measure_power.pv1": { "title": { "en": "PV input 1" } },
    "measure_power.pv2": { "title": { "en": "PV input 2" } },
    "measure_power.pv3": { "title": { "en": "PV input 3" } },
    "measure_power.pv4": { "title": { "en": "PV input 4" } },
    "measure_power.schuko1": { "title": { "en": "AC output 1" } },
    "measure_power.schuko2": { "title": { "en": "AC output 2" } },
    "measure_power.from_pv": { "title": { "en": "Home from solar" } },
    "measure_power.from_battery": { "title": { "en": "Home from battery" } },
    "measure_power.from_grid": { "title": { "en": "Home from grid" } },
    "measure_temperature": { "title": { "en": "Battery temperature" } },
    "measure_voltage": { "title": { "en": "Battery voltage" } },
    "battery_soh": { "title": { "en": "Battery health" } },
    "battery_cycles": { "title": { "en": "Battery cycles" } },
    "alarm_generic": {
      "title": { "en": "Fault" }
    }
  },
  "images": {
    "small": "/drivers/stream/assets/images/small.png",
    "large": "/drivers/stream/assets/images/large.png",
    "xlarge": "/drivers/stream/assets/images/xlarge.png"
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Polling interval (seconds)" },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": { "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls." }
    },
    {
      "id": "enable_history",
      "type": "checkbox",
      "label": { "en": "Daily energy statistics" },
      "value": true,
      "hint": { "en": "Fetch daily solar/grid/savings/CO₂ totals from EcoFlow's history API." }
    },
    {
      "id": "history_prefix",
      "type": "text",
      "label": { "en": "History model code" },
      "value": "BK621",
      "hint": { "en": "EcoFlow history metric prefix for your STREAM model (default BK621). Change if daily stats stay empty." }
    }
  ],
  "pair": [
    { "id": "credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}

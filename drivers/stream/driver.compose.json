{
  "name": { "en": "STREAM" },
  "class": "battery",
  "connectivity": ["cloud"],
  "capabilities": [
    "measure_battery",
    "measure_power",
    "measure_power.pv",
    "measure_power.grid",
    "measure_power.load",
    "meter_power.charged",
    "meter_power.discharged",
    "measure_temperature",
    "measure_voltage",
    "battery_soh",
    "charge_limit",
    "discharge_limit",
    "onoff.ac1",
    "onoff.ac2",
    "backup_reserve_soc",
    "operating_mode",
    "feed_in_control",
    "energy_solar_today",
    "energy_consumption_today",
    "energy_grid_import_today",
    "energy_grid_export_today",
    "energy_savings_today",
    "co2_today",
    "energy_independence",
    "measure_power.pv1",
    "measure_power.pv2",
    "measure_power.pv3",
    "measure_power.pv4",
    "measure_power.schuko1",
    "measure_power.schuko2",
    "measure_power.from_pv",
    "measure_power.from_battery",
    "measure_power.from_grid",
    "charge_remaining",
    "discharge_remaining",
    "battery_cycles",
    "alarm_generic"
  ],
  "capabilitiesOptions": {
    "measure_power": { "title": { "en": "Battery power" } },
    "measure_power.pv": { "title": { "en": "Solar power" } },
    "measure_power.grid": { "title": { "en": "Grid power" } },
    "measure_power.load": { "title": { "en": "Home load" } },
    "meter_power.charged": { "title": { "en": "Energy charged" } },
    "meter_power.discharged": { "title": { "en": "Energy discharged" } },
    "measure_power.pv1": { "title": { "en": "Solar PV1" } },
    "measure_power.pv2": { "title": { "en": "Solar PV2" } },
    "measure_power.pv3": { "title": { "en": "Solar PV3" } },
    "measure_power.pv4": { "title": { "en": "Solar PV4" } },
    "measure_power.schuko1": { "title": { "en": "Socket 1" } },
    "measure_power.schuko2": { "title": { "en": "Socket 2" } },
    "measure_power.from_pv": { "title": { "en": "Load from solar" } },
    "measure_power.from_battery": { "title": { "en": "Load from battery" } },
    "measure_power.from_grid": { "title": { "en": "Load from grid" } },
    "onoff.ac1": {
      "title": { "en": "AC output 1" },
      "insightsTitleTrue": { "en": "AC1 turned on" },
      "insightsTitleFalse": { "en": "AC1 turned off" }
    },
    "onoff.ac2": {
      "title": { "en": "AC output 2" },
      "insightsTitleTrue": { "en": "AC2 turned on" },
      "insightsTitleFalse": { "en": "AC2 turned off" }
    },
    "alarm_generic": {
      "title": { "en": "Fault" }
    }
  },
  "images": {
    "small": "/drivers/stream/assets/images/small.png",
    "large": "/drivers/stream/assets/images/large.png",
    "xlarge": "/drivers/stream/assets/images/xlarge.png"
  },
  "energy": {
    "homeBattery": true,
    "meterPowerImportedCapability": "meter_power.charged",
    "meterPowerExportedCapability": "meter_power.discharged"
  },
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Polling interval (seconds)" },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": { "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls." }
    },
    {
      "id": "enable_history",
      "type": "checkbox",
      "label": { "en": "Daily energy statistics" },
      "value": true,
      "hint": { "en": "Fetch daily solar/grid/savings/CO₂ totals from EcoFlow's history API." }
    },
    {
      "id": "history_prefix",
      "type": "text",
      "label": { "en": "History model code" },
      "value": "BK621",
      "hint": { "en": "EcoFlow history metric prefix for your STREAM model (default BK621). Change if daily stats stay empty." }
    }
  ],
  "pair": [
    { "id": "credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}

    "es22GridInputReadback": {
      "source": "tests/fixtures/stream_ac5000/es22_grid_input_readback_masked.json",
      "sourceBlobSha": "d51e5d06f0208f15837590521c5ad2ffdaf5d0de",
      "note": "The device's own report of Max Grid Input Power after it was written from Home Assistant, from a diagnostics download by the reporter of #284. He set 1800 W on the new control at 17:03 CEST on 2026-08-26, then left the device page in the EcoFlow app and came back, which makes the app request the settings again; this is the answer to that request. Config field 10 carries {1: 800, 2: 1800}: the input setpoint holds the written value and the grid-tied output setpoint beside it is untouched. Serials arrive masked from the capture as a run of X; the 12-character module identifier the capture's mask does not reach was replaced by hand with AABBCCDDEEFF, the same filler es21_pv_masked.json uses, preserving length.",
      "source_topics": [
        "/app/device/property/{sn}"
      ],
      "frames": [
        {
          "note": "get-all answer, 17:02:59 CEST, first frame after the connection came up.",

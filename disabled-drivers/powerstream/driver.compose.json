{
  "name": { "en": "PowerStream" },
  "class": "solarpanel",
  "connectivity": ["cloud"],
  "capabilities": [
    "measure_battery",
    "measure_power",
    "measure_power.pv",
    "measure_power.battery",
    "measure_temperature",
    "output_target_power",
    "supply_priority",
    "led_brightness",
    "ps_charge_limit",
    "ps_discharge_limit"
  ],
  "capabilitiesOptions": {
    "measure_power": { "title": { "en": "Output power" } },
    "measure_power.pv": { "title": { "en": "Solar power" } },
    "measure_power.battery": { "title": { "en": "Battery power" } }
  },
  "energy": {
    "batteries": ["INTERNAL"]
  },
  "images": {
    "small": "/drivers/powerstream/assets/images/small.png",
    "large": "/drivers/powerstream/assets/images/large.png",
    "xlarge": "/drivers/powerstream/assets/images/xlarge.png"
  },
  "settings": [
    {
      "id": "poll_interval",
      "type": "number",
      "label": { "en": "Polling interval (seconds)" },
      "value": 30,
      "min": 10,
      "max": 600,
      "hint": { "en": "How often to fetch data over REST. MQTT delivers realtime updates between polls." }
    }
  ],
  "pair": [
    { "id": "credentials" },
    { "id": "list_devices", "template": "list_devices", "navigation": { "next": "add_devices" } },
    { "id": "add_devices", "template": "add_devices" }
  ]
}

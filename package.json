{
  "name": "uk.co.zarb.ecoflow",
  "version": "1.11.0",
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --test test/*.test.js",
    "lint": "eslint --ext .js,.ts --ignore-path .gitignore .",
    "release:check": "node scripts/check-release-boundaries.mjs && node scripts/check-stream-5000-acceptance.mjs && node scripts/check-dual-ct-acceptance.mjs",
    "release:acceptance": "node scripts/check-stream-5000-acceptance.mjs --require-ready",
    "release:monitoring": "node scripts/check-stream-5000-acceptance.mjs --role unit --require-ready",
    "widgets:preview": "node scripts/generate-widget-previews.mjs",
    "release:dual-ct": "node scripts/check-dual-ct-acceptance.mjs --require-ready",
    "release:full": "node scripts/check-full-release-acceptance.mjs --require-ready"
  },
  "dependencies": {
    "mqtt": "^5.10.1"
  },
  "devDependencies": {
    "@tsconfig/node16": "^16.1.8",
    "@types/homey": "npm:homey-apps-sdk-v3-types@^0.3.12",
    "@types/node": "^22.10.0",
    "eslint": "^8.57.1",
    "eslint-config-athom": "^4.0.2",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.7"
    }
  }
}

{
  "id": "set_charge_limit",
  "title": { "en": "Set charge limit" },
  "titleFormatted": { "en": "Set charge limit to [[level]]%" },
  "args": [
    { "type": "device", "name": "device", "filter": "driver_id=stream" },
    {
      "type": "range",
      "name": "level",
      "min": 50,
      "max": 100,
      "step": 1,
      "label": "%",
      "labelDecimals": 0
    }
  ]
}

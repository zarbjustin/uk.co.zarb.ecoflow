{
  "id": "battery_soc",
  "title": {
    "en": "Battery level is above/below",
    "de": "Batteriestand ist über/unter",
    "nl": "Batterijniveau is boven/onder"
  },
  "titleFormatted": {
    "en": "Battery level is [[direction]] [[level]]%",
    "de": "Batteriestand ist [[direction]] [[level]]%",
    "nl": "Batterijniveau is [[direction]] [[level]]%"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=stream&capabilities=operating_mode"
    },
    {
      "type": "dropdown",
      "name": "direction",
      "title": {
        "en": "Direction",
        "de": "Richtung",
        "nl": "Richting"
      },
      "values": [
        {
          "id": "above",
          "title": {
            "en": "above",
            "de": "über",
            "nl": "boven"
          }
        },
        {
          "id": "below",
          "title": {
            "en": "below",
            "de": "unter",
            "nl": "onder"
          }
        }
      ]
    },
    {
      "type": "number",
      "name": "level",
      "title": {
        "en": "Battery level",
        "de": "Batteriestand",
        "nl": "Batterijniveau"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "placeholder": {
        "en": "%",
        "de": "%",
        "nl": "%"
      }
    }
  ]
}

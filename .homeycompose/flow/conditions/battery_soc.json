{
  "id": "battery_soc",
  "title": {
    "en": "Battery level is above/below",
    "de": "Batteriestand ist über/unter",
    "nl": "Batterijniveau is boven/onder"
  },
  "titleFormatted": {
    "en": "Battery level is [[direction]] [[level]]%",
    "de": "Batteriestand ist [[direction]] [[level]]%",
    "nl": "Batterijniveau is [[direction]] [[level]]%"
  },
  "args": [
    {
      "type": "device",
      "name": "device",
      "filter": "driver_id=stream"
    },
    {
      "type": "dropdown",
      "name": "direction",
      "title": {
        "en": "Direction",
        "de": "Richtung",
        "nl": "Richting"
      },
      "values": [
        {
          "id": "above",
          "title": {
            "en": "above",
            "de": "über",
            "nl": "boven"
          }
        },
        {
          "id": "below",
          "title": {
            "en": "below",
            "de": "unter",
            "nl": "onder"
          }
        }
      ]
    },
    {
      "type": "number",
      "name": "level",
      "title": {
        "en": "Battery level",
        "de": "Batteriestand",
        "nl": "Batterijniveau"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "placeholder": {
        "en": "%",
        "de": "%",
        "nl": "%"
      }
    }
  ],
  "hint": {
    "en": "Requires a recent matching observation. Unknown, stale or failed readings stop evaluation, including inversion; they are not treated as zero.",
    "de": "Erfordert eine aktuelle passende Beobachtung. Unbekannte, veraltete oder fehlgeschlagene Werte stoppen auch die umgekehrte Bedingung und werden nicht als null behandelt.",
    "nl": "Vereist een recente passende waarneming. Onbekende, verouderde of mislukte waarden stoppen ook de omgekeerde voorwaarde en worden niet als nul behandeld."
  }
}

{
  "id": "electricity_price",
  "title": {
    "en": "Electricity price is above/below",
    "de": "Strompreis ist über/unter",
    "nl": "Stroomprijs is boven/onder"
  },
  "titleFormatted": {
    "en": "Electricity price is [[direction]] [[price]]",
    "de": "Strompreis ist [[direction]] [[price]]",
    "nl": "Stroomprijs is [[direction]] [[price]]"
  },
  "hint": {
    "en": "Uses the price set via the 'Set current electricity price' action.",
    "de": "Verwendet den über die Aktion 'Aktuellen Strompreis festlegen' gesetzten Preis.",
    "nl": "Gebruikt de prijs die is ingesteld via de actie 'Huidige stroomprijs instellen'."
  },
  "args": [
    { "type": "device", "name": "device", "filter": "driver_id=stream" },
    {
      "type": "dropdown",
      "name": "direction",
      "title": { "en": "Direction", "de": "Richtung", "nl": "Richting" },
      "values": [
        { "id": "above", "title": { "en": "above", "de": "über", "nl": "boven" } },
        { "id": "below", "title": { "en": "below", "de": "unter", "nl": "onder" } }
      ]
    },
    { "type": "number", "name": "price", "min": -1000, "max": 1000, "step": 0.01, "placeholder": { "en": "price/kWh" } }
  ]
}

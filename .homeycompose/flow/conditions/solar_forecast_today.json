{
  "id": "solar_forecast_today",
  "title": {
    "en": "Solar forecast today is above/below",
    "de": "Solarprognose heute ist über/unter",
    "nl": "Zonprognose vandaag is boven/onder"
  },
  "titleFormatted": {
    "en": "Solar forecast today is [[direction]] [[kwh]] kWh",
    "de": "Solarprognose heute ist [[direction]] [[kwh]] kWh",
    "nl": "Zonprognose vandaag is [[direction]] [[kwh]] kWh"
  },
  "args": [
    { "type": "device", "name": "device", "filter": "driver_id=stream" },
    {
      "type": "dropdown",
      "name": "direction",
      "title": { "en": "Direction", "de": "Richtung", "nl": "Richting" },
      "values": [
        { "id": "above", "title": { "en": "above", "de": "über", "nl": "boven" } },
        { "id": "below", "title": { "en": "below", "de": "unter", "nl": "onder" } }
      ]
    },
    { "type": "number", "name": "kwh", "min": 0, "max": 200, "step": 0.5, "placeholder": { "en": "kWh" } }
  ]
}

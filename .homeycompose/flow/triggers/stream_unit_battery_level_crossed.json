        "en": "Direction",
        "de": "Richtung",
        "nl": "Richting"
      },
      "values": [
        {
          "id": "above",
          "title": {
            "en": "above",
            "de": "über",
            "nl": "boven"
          }
        },
        {
          "id": "below",
          "title": {
            "en": "below",
            "de": "unter",
            "nl": "onder"
          }
        }
      ]
    },
    {
      "type": "number",
      "name": "level",
      "title": {
        "en": "Battery level",
        "de": "Batteriestand",
        "nl": "Batterijniveau"
      },
      "min": 0,
      "max": 100,
      "step": 1,
      "placeholder": {
        "en": "%",
        "de": "%",
        "nl": "%"
      }
    }
  ],
  "tokens": [
    {
      "name": "battery",
      "type": "number",
      "title": {
        "en": "Battery",
        "de": "Batterie",
        "nl": "Batterij"
